rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { 
      return request.auth != null; 
    }
    
    function getUserData() { 
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; 
    }
    
    function isApproved() {
      return signedIn() && getUserData().status == 'APPROVED';
    }
    
    function isSecretary() { 
      return isApproved() && getUserData().role == 'secretary'; 
    }
    
    function belongsToPanchayat(panchayatCode) {
      return isApproved() && (getUserData().panchayatCode == panchayatCode || getUserData().role == 'admin');
    }

    // User profile documents for onboarding and secretarial approval
    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId || 
        (isSecretary() && getUserData().panchayatCode == resource.data.panchayatCode)
      );
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && (
        (isSecretary() && getUserData().panchayatCode == resource.data.panchayatCode) ||
        request.auth.uid == userId
      );
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /config/{configId} {
      allow read: if signedIn();
      allow write: if isSecretary();
    }

    // Multi-tenant Panchayat document collections
    match /panchayats/{panchayatCode} {
      allow read: if belongsToPanchayat(panchayatCode);
      allow write: if isSecretary() && getUserData().panchayatCode == panchayatCode;

      match /buildings/{buildingId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /licenses/{licenseId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /wards/{wardId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /surveys/{surveyId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /wardReports/{reportId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /notifications/{notificationId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /settings/{settingId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /syncHistory/{syncId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /whatsappLogs/{logId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }

      match /auditLogs/{logId} {
        allow read, write: if belongsToPanchayat(panchayatCode);
      }
    }

    // Fallback for legacy collections during migration
    match /panchayaths/{panchayathId} {
      allow read, write: if signedIn();
      match /{document=**} {
        allow read, write: if signedIn();
      }
    }
  }
}
