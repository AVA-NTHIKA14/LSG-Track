rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isApproved() {
      return hasUserDoc() &&
        getUserData().status in ['APPROVED', 'Approved', 'approved'];
    }

    function isAdmin() {
      return isApproved() &&
        getUserData().role in [
          'Administrator',
          'administrator',
          'admin'
        ];
    }

    function isSecretaryOrAdmin() {
      return isApproved() && (
        isAdmin() ||
        getUserData().role in ['Secretary', 'secretary']
      );
    }

    function belongsToPanchayat(panchayathId) {
      return isApproved() && (
        isAdmin() ||
        getUserData().panchayathId == 'all' ||
        getUserData().panchayatCode == 'all' ||
        getUserData().panchayathId == panchayathId ||
        getUserData().panchayatCode == panchayathId
      );
    }

    // User profiles
    match /users/{userId} {
      allow read: if signedIn();

      allow create: if signedIn() &&
        request.auth.uid == userId;

      allow update: if signedIn() &&
        (request.auth.uid == userId || isSecretaryOrAdmin());

      allow delete: if signedIn() &&
        (request.auth.uid == userId || isSecretaryOrAdmin());
    }

    // Application configuration
    match /config/{configId} {
      allow read: if signedIn();
      allow write: if isSecretaryOrAdmin();
    }

    // Panchayat documents and subcollections
    match /panchayaths/{panchayathId} {
      allow read, write: if belongsToPanchayat(panchayathId);

      match /{document=**} {
        allow read, write: if belongsToPanchayat(panchayathId);
      }
    }
  }
}
